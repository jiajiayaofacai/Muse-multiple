{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse-multiple",
  "version": "0.1.0",
  "identifier": "io.github.jiajiayaofacai.muse-multiple",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "shell", "create": false, "title": "Muse-multiple", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 620 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
      "capabilities": ["shell"]
    }
  },
  "bundle": { "active": true, "targets": ["msi", "nsis"], "icon": ["icons/generated/icon.png", "icons/generated/icon.ico"] }
}
