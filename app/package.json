{
  "name": "muse-multiple",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run src",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "tauri": "tauri",
    "test:sites": "node --test tests/sites/server.test.cjs",
    "test:connectors": "node --test tests/e2e/connector-fixture.test.cjs",
    "test:sites:start": "node tests/sites/server.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
